{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photo-next-mvp",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "env": {
    "staging": {
      "name": "photo-next-mvp-staging",
      "workers_dev": true
    }
  }
}
